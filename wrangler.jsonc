{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stocker-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pantry-keeper",
      "database_id": "a06132cc-f07d-4c5c-a595-cf65a5cb74cb"
    }
  ],
  "vars": {
    "VISION_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct",
    // the owner's fridge and shelf photos are also read by other vision models and kept as text, to score by hand
    // (photo_trials). Four extra model calls per photo, the owner's home only. Set to "off" to stop.
    "PHOTO_TRIAL": "on",
    // fridge and shelf photos go through find, crop, read (Moondream finds the packs, the phone cuts them out, Gemma 4 reads
    // each one) for every home; "owner" for the owner's home only, "off" for the single reading of the whole photo.
    // A photo takes one message from the home's daily AI share, plus one for every four packs read.
    "PHOTO_PIPELINE": "all",
    "TEXT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // everyday jobs go to this cheaper model first; its work is checked by code, and anything it gets wrong goes to TEXT_MODEL.
    // Set DELEGATE to "off" to send everything to TEXT_MODEL.
    "SMALL_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast",
    "DELEGATE": "on",
    // how the model writes what it read from an update or a receipt: "json" (14 named fields per thing, as before), "owner" (the
    // short form, one line per thing, for the owner's home and the live evals only) or "lines" (the short form for every home).
    // The short form also reads a long receipt in parts at the same time.
    "UPDATE_SHAPE": "json",
    // once per deploy, the same made-up messages are timed in both forms on the real models (photo_trials, kind "speed").
    // About 40 model calls, no person's words. "off" to stop.
    "SPEED_TRIAL": "on",
    "SPEECH_MODEL": "@cf/openai/whisper-large-v3-turbo",
    "IMAGE_MODEL": "@cf/black-forest-labs/flux-1-schnell",
    // real sign-in: every home there is (signed up or by code), a home's daily share of model-using messages,
    // and the day's ceiling for all homes together. GOOGLE_CLIENT_ID, CONTACT and MAIL_FROM are set in the dashboard.
    "HOMES_MAX": "100",
    "AI_HOME_DAY": "60",
    "AI_ALL_DAY": "2000"
  },
  // Branch builds run `npx wrangler preview`, which needs its own settings: Previews inherit nothing from production.
  // They get a database of their own (pantry-keeper-preview, made by the Worker on first request), so a branch never touches
  // a real home; the same models; no photo trials; and a small AI ceiling. No APP_PIN secret is set for Previews, so a
  // Preview stays locked unless one is added with `npx wrangler preview secret put APP_PIN`. Cron triggers run production only.
  "previews": {
    "vars": {
      "VISION_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct",
      "PHOTO_TRIAL": "off",
      "PHOTO_PIPELINE": "owner",
      "TEXT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
      "SMALL_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8-fast",
      "DELEGATE": "on",
      "UPDATE_SHAPE": "json",
      "SPEED_TRIAL": "off",
      "SPEECH_MODEL": "@cf/openai/whisper-large-v3-turbo",
      "IMAGE_MODEL": "@cf/black-forest-labs/flux-1-schnell",
      "HOMES_MAX": "5",
      "AI_HOME_DAY": "60",
      "AI_ALL_DAY": "100"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "pantry-keeper-preview",
        "database_id": "1af6713c-338a-445d-8e56-65e8052524a7"
      }
    ],
    "ai": { "binding": "AI" },
    "version_metadata": { "binding": "CF_VERSION" }
  },
  "triggers": { "crons": ["* * * * *"] },
  "version_metadata": { "binding": "CF_VERSION" },
  "observability": { "enabled": true }
}
